{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$l=New-Object System.Net.HttpListener;$l.Prefixes.Add('http://localhost:4173/');$l.Start();$root='G:\\Mijn Drive\\Flylikeag6';while($l.IsListening){$c=$l.GetContext();$p=[Uri]::UnescapeDataString($c.Request.Url.AbsolutePath.TrimStart('/'));if(!$p){$p='index.html'};$f=Join-Path $root $p;if(Test-Path $f -PathType Leaf){$b=[IO.File]::ReadAllBytes($f);if($f.EndsWith('.html')){$c.Response.ContentType='text/html'}elseif($f.EndsWith('.js')){$c.Response.ContentType='application/javascript'}elseif($f.EndsWith('.css')){$c.Response.ContentType='text/css'}elseif($f.EndsWith('.png')){$c.Response.ContentType='image/png'};$c.Response.OutputStream.Write($b,0,$b.Length)}else{$c.Response.StatusCode=404};$c.Response.Close()}"
      ],
      "port": 4173
    }
  ]
}
